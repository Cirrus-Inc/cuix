{
  "name": "@cirrus/cuix",
  "version": "0.10.1",
  "description": "Accessible-by-default CSS themes and React components: six WCAG 2.2 AAA themes, 44px targets, one semantic vocabulary",
  "keywords": [
    "design-system",
    "design-tokens",
    "react",
    "radix-ui",
    "tailwindcss",
    "accessibility",
    "wcag"
  ],
  "license": "MIT",
  "repository": "github:Cirrus-Inc/cuix",
  "homepage": "https://github.com/Cirrus-Inc/cuix#readme",
  "bugs": {
    "url": "https://github.com/Cirrus-Inc/cuix/issues"
  },
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.embed.css": "./dist/tokens.embed.css",
    "./tokens.host.css": "./dist/tokens.host.css",
    "./theme.css": "./dist/theme.css",
    "./theme-init.js": "./dist/theme-init.js",
    "./theme-init.sha256": "./dist/theme-init.sha256",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./eslint": "./eslint/a11y.js"
  },
  "sideEffects": [
    "*.css",
    "./dist/theme-init.js"
  ],
  "files": [
    "dist",
    "eslint",
    "scripts/check-ui-className.mjs",
    "scripts/check-disabled-title.sh",
    "scripts/check-nested-scrollers.sh",
    "scripts/install-gates.sh"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.ts && tsc -p tsconfig.build.json",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:ui": "node scripts/check-ui-className.mjs",
    "check:disabled-title": "bash scripts/check-disabled-title.sh",
    "check:nested-scrollers": "bash scripts/check-nested-scrollers.sh",
    "check:gates": "npm run check:ui && npm run check:disabled-title && npm run check:nested-scrollers",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run check:contrast && npm run check:gates && npm run build && npm test",
    "lint": "eslint .",
    "playground": "vite",
    "e2e": "playwright test",
    "check:all": "npm run check && npm run e2e",
    "smoke:consumer": "bash scripts/consumer-smoke.sh",
    "release": "bash scripts/release.sh",
    "demo": "vite build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "lucide-react": "1.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": "^1",
    "eslint-plugin-jsx-a11y": "^6",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-select": "^2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-popover": {
      "optional": true
    },
    "@radix-ui/react-select": {
      "optional": true
    }
  }
}
